# Database
DB_USER=senyar
DB_PASSWORD=your_db_password
DB_NAME=senyar
DB_HOST=localhost
DB_PORT=5432

# Cache
CACHE_HOST=localhost
CACHE_PORT=6379

# pgAdmin
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=your_pgadmin_password

# ODK Central
ODK_BASE_URL=https://data.dayawarga.com
ODK_PROJECT_ID=1
ODK_EMAIL=your_odk_email@example.com
ODK_PASSWORD=your_odk_password
ODK_FORM_ID=form_posko_v1
ODK_FEED_FORM_ID=form_feed_v1
ODK_FASKES_FORM_ID=form_faskes_v1

# API
API_PORT=8080
LOG_LEVEL=debug
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
PHOTO_STORAGE_PATH=./storage/photos

# S3 Storage (optional - for cloud photo storage)
S3_ENABLED=false
S3_ENDPOINT=is3.cloudhost.id
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
S3_PATH_PREFIX=

# Scheduler
SCHEDULER_ENABLED=true

# API Key for protected endpoints (sync, scheduler)
# Required for POST /sync/*, /scheduler/* endpoints
SYNC_API_KEY=your_secure_api_key_here

# ==========================================================================
# AUTHENTIK IDENTITY PROVIDER (for Admin Portal profile)
# ==========================================================================
# Secret key for Authentik (generate with: openssl rand -base64 60)
AUTHENTIK_SECRET_KEY=your_authentik_secret_key

# Authentik PostgreSQL (separate from main database)
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=your_authentik_db_password
AUTHENTIK_POSTGRES_DB=authentik

# ==========================================================================
# ADMIN PORTAL (for Admin Portal profile)
# ==========================================================================
# OIDC Client ID (create in Authentik admin panel)
ADMIN_PORTAL_OIDC_CLIENT_ID=your_oidc_client_id

# OIDC settings for Go API (validate tokens)
OIDC_ISSUER_URL=https://auth.dayawarga.com/application/o/admin-portal/
OIDC_CLIENT_ID=your_oidc_client_id

# App URL (for invitation links)
APP_BASE_URL=http://localhost:5173

# ==========================================================================
# SMTP (for email notifications - Mailtrap or similar)
# ==========================================================================
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@dayawarga.com
SMTP_FROM_NAME=Dayawarga

# ==========================================================================
# AUTHENTIK WEBHOOK (for auto-sync users to ODK)
# ==========================================================================
# Secret for authenticating Authentik webhook calls (generate with: openssl rand -hex 32)
AUTHENTIK_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================================================
# TRAEFIK
# ==========================================================================
ACME_EMAIL=admin@dayawarga.com
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$your_hashed_password
