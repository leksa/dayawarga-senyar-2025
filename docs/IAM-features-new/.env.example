# ODK Admin Portal - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://odk_admin:odk_admin_password@localhost:5432/odk_admin_db

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTHENTIK OIDC
# =============================================================================
# Your Authentik instance URL
AUTHENTIK_URL=https://auth.example.com

# OIDC Client credentials (create in Authentik Admin)
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret

# Callback URL (must match what's configured in Authentik)
AUTHENTIK_REDIRECT_URI=http://localhost:3001/api/auth/callback

# =============================================================================
# ODK CENTRAL
# =============================================================================
# Your ODK Central instance URL
ODK_CENTRAL_URL=https://odk.example.com

# ODK Central admin credentials (for API access)
ODK_CENTRAL_EMAIL=admin@example.com
ODK_CENTRAL_PASSWORD=your-odk-password

# =============================================================================
# SECURITY
# =============================================================================
# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-generate-random-string

# JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-generate-random-string

# =============================================================================
# OPTIONAL - LOGGING
# =============================================================================
# LOG_LEVEL=debug
# LOG_FORMAT=json
