# Authentik Environment Variables
# Copy this file to .env and fill in the values

# ==========================================================================
# REQUIRED - Must be set before starting
# ==========================================================================

# Secret key for Authentik (generate with: openssl rand -base64 60)
AUTHENTIK_SECRET_KEY=

# PostgreSQL password
AUTHENTIK_POSTGRES_PASSWORD=

# ==========================================================================
# OPTIONAL - Defaults provided
# ==========================================================================

# PostgreSQL configuration
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_DB=authentik

# Ports (change if conflicts with other services)
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443

# ==========================================================================
# EMAIL CONFIGURATION (for password reset, notifications)
# ==========================================================================
# Mailtrap example:
AUTHENTIK_EMAIL__HOST=live.smtp.mailtrap.io
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=noreply@dayawarga.com
