# Authentik Environment Variables
# Copy this file to .env and fill in the values

# ==========================================================================
# REQUIRED - Must be set before starting
# ==========================================================================

# Secret key for Authentik (generate with: openssl rand -base64 60)
AUTHENTIK_SECRET_KEY=

# PostgreSQL password
AUTHENTIK_POSTGRES_PASSWORD=

# ==========================================================================
# OPTIONAL - Defaults provided
# ==========================================================================

# PostgreSQL configuration
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_DB=authentik

# Ports (change if conflicts with other services)
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443

# ==========================================================================
# EMAIL CONFIGURATION (Optional - for password reset, notifications)
# ==========================================================================
# AUTHENTIK_EMAIL_HOST=smtp.example.com
# AUTHENTIK_EMAIL_PORT=587
# AUTHENTIK_EMAIL_USE_TLS=true
# AUTHENTIK_EMAIL_USERNAME=
# AUTHENTIK_EMAIL_PASSWORD=
# AUTHENTIK_EMAIL_FROM=authentik@example.com
